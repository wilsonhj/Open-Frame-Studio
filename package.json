{
  "name": "open-soul-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "mock-comfy": "node --experimental-strip-types tests/mock-comfy/server.ts",
    "check:owners": "node scripts/check-owners.mjs auto",
    "check:models": "node scripts/check-models.mjs",
    "check:graphs": "node scripts/check-object-info.mjs",
    "demo": "node scripts/demo.mjs",
    "mock": "DEMO_NO_NEXT=1 node scripts/demo.mjs"
  },
  "dependencies": {
    "@comfyorg/sdk": "0.5.0",
    "fflate": "0.8.3",
    "next": "16.4.3",
    "onnxruntime-node": "1.30.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "//": "pnpm.ignoredBuiltDependencies: onnxruntime-node's postinstall only downloads optional GPU (CUDA) providers from NuGet. The CPU runtime the YuNet face detector uses ships inside the package, so the script is skipped and installs need no network.",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "onnxruntime-node"
    ]
  }
}
