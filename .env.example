# Comfy API key (platform.comfy.org/profile/api-keys). Server-side only: never prefix with NEXT_PUBLIC_.
COMFY_API_KEY=

# Optional: target a self-hosted ComfyUI behind comfy-api-proxy instead of Comfy Cloud.
# Leave unset/blank for Comfy Cloud (https://cloud.comfy.org).
# COMFY_BASE_URL=http://127.0.0.1:8189
COMFY_BASE_URL=

# Signs per-browser job handles. REQUIRED in production: a long random value, e.g. `openssl rand -base64 32`.
SESSION_SECRET=

# Gates job submission (every job is billed to COMFY_API_KEY). In production, submits are refused
# unless this is set or ALLOW_PUBLIC_SUBMIT=true.
STUDIO_ACCESS_CODE=
# ALLOW_PUBLIC_SUBMIT=true

# In-memory rate limits per server instance (submits per hour).
# SUBMITS_PER_HOUR_PER_IP=20
# SUBMITS_PER_HOUR=200
