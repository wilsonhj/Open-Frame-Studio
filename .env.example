# Comfy API key (platform.comfy.org/profile/api-keys). Server-side only: never prefix with NEXT_PUBLIC_.
COMFY_API_KEY=

# Optional: target a self-hosted ComfyUI behind comfy-api-proxy instead of Comfy Cloud.
# Leave unset/blank for Comfy Cloud (https://cloud.comfy.org).
# COMFY_BASE_URL=http://127.0.0.1:8189
COMFY_BASE_URL=

# Signs job handles (unguessable capabilities for /api/jobs results). REQUIRED in production: a long random value, e.g. `openssl rand -base64 32`.
HANDLE_SECRET=

# Gates job submission (every job is billed to COMFY_API_KEY). In production, submits are refused
# unless this is set or ALLOW_PUBLIC_SUBMIT=true, and it must be at least 12 characters
# (a long random value, e.g. `openssl rand -base64 18`).
STUDIO_ACCESS_CODE=
# ALLOW_PUBLIC_SUBMIT=true
# Wrong codes: 10 per client (needs TRUSTED_PROXY_HOPS) and 200 overall per 15 minutes, then 429.

# In-memory rate limits per server instance (submits per hour).
# SUBMITS_PER_HOUR=200
# Per-IP limit; applies only when TRUSTED_PROXY_HOPS says how many proxies append to X-Forwarded-For.
# SUBMITS_PER_HOUR_PER_IP=20
# TRUSTED_PROXY_HOPS=1

# Budget for one /api/jobs run (ms); overdue jobs are canceled by a server-side sweep.
# JOB_DEADLINE_MS=900000
# Where job deadlines (and pipeline runs) are stored.
# DATA_DIR=.data
